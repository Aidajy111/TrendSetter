# Конфиги базы данных
DB_CLIENT=postgres
DB_NAME=trendsetter_db
DB_USER=trendsetter_admin
DB_PASSWORD=trendsetter_secret_password
DB_PORT=5432

# Конфиги Strapi 
APP_KEYS=generate_random_key_1,generate_random_key_2
API_TOKEN_SALT=random_salt_here
ADMIN_JWT_SECRET=random_admin_secret_here
JWT_SECRET=random_jwt_secret_here

# Конфиги фронта. http://localhost:4444 - это адрес бекенда на strapi 
REACT_APP_API_URL=http://localhost:4444